{
  "name": "meal-app",
  "private": true,
  "version": "0.1.0",
  "description": "自分専用の食事管理 PWA(端末内保存・オフライン・計算はプログラムで決定的に)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:private": "node scripts/check-private.mjs",
    "privacy:status": "node scripts/privacy-status.mjs",
    "food-db": "node scripts/build-food-db.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "idb": "8.0.4",
    "preact": "10.29.8"
  }
}
